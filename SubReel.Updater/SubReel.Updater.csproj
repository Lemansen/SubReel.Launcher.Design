<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Без окна консоли: программа запускается лаунчером в фоне, весь ход работы пишется в журнал, путь передаётся аргументом log. Зависимостей от остальных проектов нет. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SubReel.Updater</AssemblyName>
    <RootNamespace>SubReel.Updater</RootNamespace>
  </PropertyGroup>
</Project>
