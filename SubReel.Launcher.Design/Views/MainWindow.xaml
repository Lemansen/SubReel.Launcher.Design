<Window x:Class="SubReel.Launcher.Design.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctl="clr-namespace:SubReel.Launcher.Design.Views.Controls"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="SubReel Launcher" Width="1100" Height="700" MinWidth="1000" MinHeight="660"
 WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
 Loaded="Window_Loaded" StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged" PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown"
 Background="Transparent" Foreground="{StaticResource TextMain}" FontFamily="Segoe UI">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
 </shell:WindowChrome.WindowChrome>

 <!-- .app-shell: скруглённое окно (radius 32), фон #0c0c0f + свечение + картинка обновления выбранной версии -->
 <Border x:Name="WindowFrame" CornerRadius="32" Background="#0C0C0F" BorderBrush="#0FFFFFFF" BorderThickness="1">
 <Grid x:Name="RootGrid">
  <!-- Картинка обновления выбранной версии (ImageBrush задаётся в коде) -->
  <Border x:Name="HeroBg" CornerRadius="31" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
  <!-- Затемнение только под текстом (слева) и снизу, сама картинка остаётся яркой -->
  <Border x:Name="HeroShade" CornerRadius="31" IsHitTestVisible="False">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
     <GradientStop Color="#B80C0C0F" Offset="0"/>
     <GradientStop Color="#5C0C0C0F" Offset="0.42"/>
     <GradientStop Color="#000C0C0F" Offset="0.78"/>
    </LinearGradientBrush>
   </Border.Background>
  </Border>
  <Border x:Name="HeroShadeBottom" CornerRadius="31" IsHitTestVisible="False">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#400C0C0F" Offset="0"/>
     <GradientStop Color="#000C0C0F" Offset="0.3"/>
     <GradientStop Color="#000C0C0F" Offset="0.62"/>
     <GradientStop Color="#D90C0C0F" Offset="1"/>
    </LinearGradientBrush>
   </Border.Background>
  </Border>
  <!-- radial-gradient(circle at 50% -20%, rgba(76,133,255,.12), transparent 50%) -->
  <Border x:Name="GlowBg" CornerRadius="31" IsHitTestVisible="False">
   <Border.Background>
    <RadialGradientBrush Center="0.5,-0.2" GradientOrigin="0.5,-0.2" RadiusX="0.456" RadiusY="0.717">
     <GradientStop Color="#1F4C85FF" Offset="0"/>
     <GradientStop Color="#004C85FF" Offset="1"/>
    </RadialGradientBrush>
   </Border.Background>
  </Border>

  <!-- padding 24px, строки 76 / 1fr / 110, зазор 20 -->
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>

   <!-- ===== NAVBAR ===== -->
   <Border x:Name="HeaderPanel" Grid.Row="0" CornerRadius="24" Background="#D9121216" BorderBrush="#0FFFFFFF" BorderThickness="1" PreviewMouseLeftButtonDown="Header_DragWindow" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
    <!-- justify-content: space-between → Auto / * / Auto / * / Auto -->
    <Grid Margin="28,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>

     <!-- .logo-zone -->
     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentGradient}">
       <TextBlock Text="S" Foreground="#000000" FontSize="17.6" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="SubReel" FontSize="15.2" FontWeight="ExtraBold"/>
       <TextBlock Text="v0.1.0" FontSize="11.2" Foreground="{StaticResource TextMuted}"/>
      </StackPanel>
     </StackPanel>

     <!-- .nav-links -->
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Command="{Binding ShowHomeCommand}" Tag="{Binding Nav.IsHomeTabActive, Converter={StaticResource ActiveTag}}">
       <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconHome}"/></Canvas></Viewbox>
        <TextBlock Text="Главная" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Button x:Name="CommunityNav" Style="{StaticResource NavButton}" Margin="8,0,0,0" Command="{Binding ShowCommunityCommand}" Tag="{Binding Nav.IsCommunityTabActive, Converter={StaticResource ActiveTag}}">
       <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconCompass}"/></Canvas></Viewbox>
        <TextBlock Text="Сообщество" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <!-- «Настройки» убраны из шапки: они открываются из меню профиля. Вместо них — SubReel Studio Hub. -->
      <Button x:Name="HubNav" Style="{StaticResource NavButton}" Margin="8,0,0,0" Command="{Binding ShowHubCommand}" Tag="{Binding Nav.IsHubTabActive, Converter={StaticResource ActiveTag}}">
       <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSparkles}"/></Canvas></Viewbox>
        <TextBlock Text="Studio Hub" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
     </StackPanel>

     <!-- .header-right-zone (gap 16) -->
     <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="ProfilePillButton" Style="{StaticResource ProfilePill}" Command="{Binding ToggleProfileMenuCommand}"
              BorderBrush="{Binding Profile.Look.FrameBrush}" BorderThickness="{Binding Profile.Look.FrameThickness}" Effect="{Binding Profile.Look.FrameGlow}">
       <StackPanel Orientation="Horizontal">
        <!-- Аватарка (инициалы / голова скина / своя картинка) и ник (цвет, в т.ч. переливающийся) берутся из ProfileLook -->
        <ctl:AvatarControl AccountName="{Binding Profile.ActiveName}" Look="{Binding Profile.Look}" Size="34" IsHitTestVisible="False" VerticalAlignment="Center"/>
        <TextBlock x:Name="UsernameText" Text="{Binding Profile.ActiveName}" Foreground="{Binding Profile.Look.NickBrush}" Margin="11,0,10,0" MaxWidth="150" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        <Viewbox x:Name="ProfileChevron" Width="16" Height="16" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
         <Viewbox.RenderTransform><RotateTransform Angle="0"/></Viewbox.RenderTransform>
         <Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" StrokeThickness="2.4" Data="{StaticResource IconChevronDown}"/></Canvas>
        </Viewbox>
       </StackPanel>
      </Button>
      <!-- .window-controls -->
      <Border Margin="16,0,0,0" Background="#26000000" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="4">
       <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Свернуть">
         <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconMinus}"/></Canvas></Viewbox>
        </Button>
        <Button Style="{StaticResource WindowButton}" Margin="4,0,0,0" Click="Maximize_Click" ToolTip="Развернуть">
         <Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSquare}"/></Canvas></Viewbox>
        </Button>
        <Button Style="{StaticResource WindowCloseButton}" Margin="4,0,0,0" Click="Close_Click" ToolTip="Закрыть">
         <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconX}"/></Canvas></Viewbox>
        </Button>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </Border>

   <!-- ===== CONTENT (.content) ===== -->
   <Grid x:Name="ContentArea" Grid.Row="1" Margin="0,20" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>

    <Grid x:Name="HomePanel">
     <!-- Текст слева: чип обновления, заголовок, описание, новости -->
     <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,12" MaxWidth="520">
      <Border x:Name="HeroChip" HorizontalAlignment="Left" Background="#2E4C85FF" BorderBrush="#664C85FF" BorderThickness="1" CornerRadius="20" Padding="12,6">
       <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
       <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" Fill="#78C8FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="HeroChipText" Text="{Binding Home.HeroChipText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D6EBFF"/>
       </StackPanel>
      </Border>
      <TextBlock x:Name="HeroTitle" Margin="0,16,0,0" FontSize="52" FontWeight="Black" Foreground="#FFFFFF" LineHeight="58">
       <TextBlock.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="18" Opacity="0.55"/></TextBlock.Effect>
       <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
       <Run Text="Твой мир."/><LineBreak/><Run Text="Твои правила."/>
      </TextBlock>
      <TextBlock x:Name="HeroSub" Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="400" FontSize="14.4" LineHeight="22" Foreground="#E4E4E7">
       <TextBlock.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="10" Opacity="0.6"/></TextBlock.Effect>
       <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
       Добро пожаловать, <Run Text="{Binding Profile.ActiveName, Mode=OneWay}" Foreground="#78C8FF" FontWeight="SemiBold"/>! Запускай любые версии, создавай свои приключения и открывай новые миры вместе с SubReel.
      </TextBlock>
      <Button x:Name="NewsChipBtn" HorizontalAlignment="Left" Margin="0,18,0,0" Style="{StaticResource NewsChip}" Command="{Binding OpenNewsCommand}">
       <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
       <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,10,0"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource AccentLight}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconFlame}"/></Canvas></Viewbox>
        <TextBlock Text="Свежие новости проекта" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
     </StackPanel>

     <!-- Мини-информация об обновлении выбранной версии -->
     <Border x:Name="InfoCard" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Width="300" Padding="18,16" CornerRadius="20" Background="#B8141419" BorderBrush="#1FFFFFFF" BorderThickness="1" Visibility="{Binding Home.IsInfoCardVisible, Converter={StaticResource BoolToVis}}" Opacity="0">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <StackPanel x:Name="InfoBody">
       <TextBlock x:Name="InfoLabel" Text="{Binding Home.InfoLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentLight}"/>
       <TextBlock x:Name="InfoTitle" Text="{Binding Home.InfoTitle}" Margin="0,5,0,0" FontSize="22" FontWeight="Black"/>
       <TextBlock x:Name="InfoMeta" Text="{Binding Home.InfoMeta}" Margin="0,2,0,0" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
       <TextBlock x:Name="InfoSummary" Margin="0,10,0,0" FontSize="12.5" LineHeight="18" Foreground="#D4D4D8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" Text="{Binding Home.InfoSummary}" Visibility="{Binding Home.HasInfoSummary, Converter={StaticResource BoolToVis}}"/>
       <TextBlock x:Name="InfoFooter" Text="{Binding Home.InfoFooter}" Margin="0,12,0,0" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
      </StackPanel>
     </Border>

     <!-- Подсказка: прокрути вниз → все версии -->
     <Button x:Name="ScrollHint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Style="{StaticResource NavButton}" Padding="14,6" Command="{Binding EnterVersionsCommand}">
      <StackPanel>
       <Border Width="20" Height="30" CornerRadius="10" BorderBrush="#99FFFFFF" BorderThickness="1.5" HorizontalAlignment="Center">
        <Border x:Name="ScrollDot" Width="3.5" Height="7" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
         <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        </Border>
       </Border>
       <TextBlock Text="Все версии" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
     </Button>
    </Grid>

    <Grid x:Name="CommunityPanel" Visibility="Collapsed">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Сообщество" FontSize="48" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,8">
       <TextBlock.Foreground>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0.4"/><GradientStop Color="#A1A1AA" Offset="1"/></LinearGradientBrush>
       </TextBlock.Foreground>
      </TextBlock>
      <TextBlock Text="Раздел в разработке." Foreground="{StaticResource TextMuted}" FontSize="16" HorizontalAlignment="Center"/>
     </StackPanel>
    </Grid>

    <!-- ===== SubReel Studio Hub (раздел в разработке) ===== -->
    <Grid x:Name="HubPanel" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <StackPanel VerticalAlignment="Center" Margin="4,0">
       <Border x:Name="HubBanner" Height="168" CornerRadius="24" BorderBrush="#26A66BFF" BorderThickness="1" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#2A1659" Offset="0"/><GradientStop Color="#13204A" Offset="0.6"/><GradientStop Color="#111114" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
        <Grid>
         <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,10,0" IsHitTestVisible="False">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#55A66BFF" Offset="0"/><GradientStop Color="#00A66BFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
         </Ellipse>
         <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,-110" IsHitTestVisible="False">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#404C85FF" Offset="0"/><GradientStop Color="#004C85FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
         </Ellipse>
         <Viewbox Width="128" Height="128" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,64,0" IsHitTestVisible="False">
          <Canvas Width="24" Height="24"><Path Stroke="#77A66BFF" StrokeThickness="0.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconCube}"/></Canvas>
         </Viewbox>
         <Viewbox Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,48,0" IsHitTestVisible="False">
          <Canvas Width="24" Height="24"><Path Stroke="#8878C8FF" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconSparkles}"/></Canvas>
         </Viewbox>
         <StackPanel Margin="32,0,200,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
           <Border CornerRadius="10" Padding="10,4" Background="#26A66BFF" BorderBrush="#55A66BFF" BorderThickness="1">
            <TextBlock Text="ИНСТРУМЕНТЫ И ПОМОЩНИКИ" FontSize="10" FontWeight="Bold" Foreground="#D6BFFF"/>
           </Border>
           <Border CornerRadius="10" Padding="10,4" Margin="8,0,0,0" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
            <TextBlock Text="В РАЗРАБОТКЕ" FontSize="10" FontWeight="Bold" Foreground="#E4E4E7"/>
           </Border>
          </StackPanel>
          <TextBlock Text="SubReel Studio Hub" Margin="0,12,0,0" FontSize="38" FontWeight="Black" Foreground="#FFFFFF"/>
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560" FontSize="13.5" LineHeight="20" Foreground="#D4D4D8"
                     Text="Отдельное направление SubReel: инструменты и помощники для тех, кто создаёт собственную инфраструктуру и контент Minecraft. Раздел ещё в разработке — ниже то, что здесь появится."/>
         </StackPanel>
        </Grid>
       </Border>

       <UniformGrid x:Name="HubCards" Columns="4" Margin="0,16,0,0">
        <Button Style="{StaticResource HubCard}" Command="{Binding Hub.OpenToolCommand}" CommandParameter="Server Studio" Margin="0,0,12,0">
         <StackPanel>
          <DockPanel>
           <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Padding="8,3" Background="#26A66BFF" BorderBrush="#40A66BFF" BorderThickness="1"><TextBlock Text="В РАЗРАБОТКЕ" FontSize="9" FontWeight="Bold" Foreground="#D6BFFF"/></Border>
           <Border Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Left" Background="#1AA66BFF" BorderBrush="#40A66BFF" BorderThickness="1">
            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource AccentPurple}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconServer}"/></Canvas></Viewbox>
           </Border>
          </DockPanel>
          <TextBlock Text="Server Studio" Margin="0,16,0,0" FontSize="17" FontWeight="Bold"/>
          <TextBlock Margin="0,6,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Text="Свой локальный сервер Minecraft: выбор версии и загрузчика, настройка параметров, запуск и остановка."/>
         </StackPanel>
        </Button>
        <Button Style="{StaticResource HubCard}" Command="{Binding Hub.OpenToolCommand}" CommandParameter="Skin Studio" Margin="0,0,12,0">
         <StackPanel>
          <DockPanel>
           <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Padding="8,3" Background="#26A66BFF" BorderBrush="#40A66BFF" BorderThickness="1"><TextBlock Text="В РАЗРАБОТКЕ" FontSize="9" FontWeight="Bold" Foreground="#D6BFFF"/></Border>
           <Border Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Left" Background="#1A4C85FF" BorderBrush="#404C85FF" BorderThickness="1">
            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource AccentLight}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconPen}"/></Canvas></Viewbox>
           </Border>
          </DockPanel>
          <TextBlock Text="Skin Studio" Margin="0,16,0,0" FontSize="17" FontWeight="Bold"/>
          <TextBlock Margin="0,6,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Text="Создание собственного скина: редактирование персонажа, предпросмотр модели, сохранение готового файла."/>
         </StackPanel>
        </Button>
        <Button Style="{StaticResource HubCard}" Command="{Binding Hub.OpenToolCommand}" CommandParameter="Mod Studio" Margin="0,0,12,0">
         <StackPanel>
          <DockPanel>
           <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Padding="8,3" Background="#26A66BFF" BorderBrush="#40A66BFF" BorderThickness="1"><TextBlock Text="В РАЗРАБОТКЕ" FontSize="9" FontWeight="Bold" Foreground="#D6BFFF"/></Border>
           <Border Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Left" Background="#1AA66BFF" BorderBrush="#40A66BFF" BorderThickness="1">
            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource AccentPurple}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconPackage}"/></Canvas></Viewbox>
           </Border>
          </DockPanel>
          <TextBlock Text="Mod Studio" Margin="0,16,0,0" FontSize="17" FontWeight="Bold"/>
          <TextBlock Margin="0,6,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Text="Инструменты для модов: помощь в организации, а в будущем — создание собственных сборок."/>
         </StackPanel>
        </Button>
        <Button Style="{StaticResource HubCard}" Command="{Binding Hub.OpenToolCommand}" CommandParameter="Другие инструменты">
         <StackPanel>
          <DockPanel>
           <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Padding="8,3" Background="#26A66BFF" BorderBrush="#40A66BFF" BorderThickness="1"><TextBlock Text="В РАЗРАБОТКЕ" FontSize="9" FontWeight="Bold" Foreground="#D6BFFF"/></Border>
           <Border Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Left" Background="#0DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource TextMuted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconPlus}"/></Canvas></Viewbox>
           </Border>
          </DockPanel>
          <TextBlock Text="Другие инструменты" Margin="0,16,0,0" FontSize="17" FontWeight="Bold"/>
          <TextBlock Margin="0,6,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Text="Новые помощники для Minecraft появятся здесь позже."/>
         </StackPanel>
        </Button>
       </UniformGrid>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>

   <!-- ===== FOOTER (.bottom-bar) ===== -->
   <Border x:Name="FooterPanel" Grid.Row="2" CornerRadius="24" Background="#111114" BorderBrush="#0FFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
    <Grid Margin="28,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition x:Name="ProgressColumn" Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>

     <!-- .bottom-left -->
     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource FooterButtonAccent}" Command="{Binding OpenBuildsCommand}">
       <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconLayers}"/></Canvas></Viewbox>
        <TextBlock Text="Создать сборку" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Button x:Name="VersionButton" Style="{StaticResource FooterButtonMuted}" Margin="12,0,0,0" Command="{Binding VersionDropdown.ToggleCommand}" ToolTip="{Binding VersionDropdown.StatusToolTip}">
       <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}"/></Canvas></Viewbox>
        <TextBlock Text="Версия: " VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Text="{Binding VersionDropdown.VersionLabel}" VerticalAlignment="Center"/>
        <!-- Статус установки выбранной версии: зелёный — установлена, жёлтый — нет (цвет задаётся из кода) -->
        <Ellipse x:Name="VersionStatusDot" Width="7" Height="7" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding VersionDropdown.ShowStatusDot, Converter={StaticResource BoolToVis}}">
         <Ellipse.Style>
          <Style TargetType="Ellipse">
           <Setter Property="Fill" Value="#FBBF24"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding VersionDropdown.IsSelectedInstalled}" Value="True"><Setter Property="Fill" Value="#4ADE80"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </Ellipse.Style>
        </Ellipse>
        <Viewbox x:Name="VersionChevron" Width="14" Height="14" Margin="8,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
         <Viewbox.RenderTransform><RotateTransform Angle="0"/></Viewbox.RenderTransform>
         <Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" StrokeThickness="2.4" Data="{StaticResource IconChevronUp}"/></Canvas>
        </Viewbox>
       </StackPanel>
      </Button>
     </StackPanel>

     <!-- .progress-wrapper: раскрывается между левыми кнопками и «Играть» (gap 30 / 24) -->
     <StackPanel x:Name="ProgressPanel" Grid.Column="1" Margin="30,0,24,0" MaxWidth="0" Opacity="0" ClipToBounds="True" VerticalAlignment="Center">
      <DockPanel Margin="0,0,0,6">
       <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Text="{Binding Launch.ProgressText}" FontSize="13.6" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
       <TextBlock x:Name="StatusText" Text="{Binding Launch.StatusText}" FontSize="13.6" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <ProgressBar x:Name="LaunchProgress" Style="{StaticResource LaunchProgressBar}" Value="{Binding Launch.Progress, Mode=OneWay}"/>
     </StackPanel>

     <!-- .play-btn 260x64 -->
     <Button x:Name="PlayButton" Grid.Column="2" Content="{Binding Launch.PlayText}" Tag="{Binding Launch.State, Converter={StaticResource EnumToTag}}" Command="{Binding Launch.PlayCommand}" Style="{StaticResource PlayButton}" Width="260" Height="64" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Grid>

  <!-- Индикатор «страниц»: главная / все версии -->
  <StackPanel x:Name="PageDots" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Panel.ZIndex="4">
   <Border Padding="6" Background="Transparent" Cursor="Hand"><Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ExitVersionsCommand}"/></Border.InputBindings><Border x:Name="DotHome" Width="6" Height="22" CornerRadius="3" Background="#78C8FF"/></Border>
   <Border Padding="6" Background="Transparent" Cursor="Hand"><Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding DotVersionsCommand}"/></Border.InputBindings><Border x:Name="DotVersions" Width="6" Height="6" CornerRadius="3" Background="#55FFFFFF"/></Border>
  </StackPanel>

  <!-- ===== Меню профиля: аккаунты и профиль ===== -->
  <Grid x:Name="ProfileMenuHost" Panel.ZIndex="20" Visibility="Collapsed">
   <Border Background="Transparent">
    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding CloseProfileMenuCommand}"/></Border.InputBindings>
   </Border>
   <Border x:Name="ProfileMenuCard" Width="304" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,92,171,0" Padding="10" CornerRadius="20" Background="#F5141419" BorderBrush="#1FFFFFFF" BorderThickness="1" Opacity="0" RenderTransformOrigin="1,0">
    <Border.RenderTransform><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="8" BlurRadius="30" Opacity="0.5"/></Border.Effect>
    <StackPanel>
     <!-- Активный аккаунт: у аватарки своя рамка того же стиля, что у кнопки профиля (если рамка включена) -->
     <Grid Margin="6,4,6,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ctl:AvatarControl AccountName="{Binding Profile.ActiveName}" Look="{Binding Profile.Look}" ShowRing="True" Size="44" RingedSize="52" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="{Binding Profile.ActiveName}" Foreground="{Binding Profile.Look.NickBrush}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Profile.ActiveKindText}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
      </StackPanel>
     </Grid>
     <Border Height="1" Background="#12FFFFFF" Margin="4,0,4,8"/>
     <TextBlock Text="АККАУНТЫ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="10,0,0,6"/>
     <ItemsControl ItemsSource="{Binding Profile.Accounts}" Focusable="False"/>
     <Button Style="{StaticResource MenuItemButton}" Command="{Binding OpenAddAccountCommand}" Margin="0,2,0,0">
      <StackPanel Orientation="Horizontal">
       <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource AccentLight}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconPlus}"/></Canvas></Viewbox>
       </Border>
       <TextBlock Text="Добавить аккаунт" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentLight}" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Style="{StaticResource MenuItemButton}" Command="{Binding SignInMicrosoftCommand}" Visibility="{Binding Profile.IsMicrosoftAvailable, Converter={StaticResource BoolToVis}}">
      <StackPanel Orientation="Horizontal">
       <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Canvas Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Rectangle Canvas.Left="0" Canvas.Top="0" Width="6.5" Height="6.5" Fill="#F25022"/>
         <Rectangle Canvas.Left="7.5" Canvas.Top="0" Width="6.5" Height="6.5" Fill="#7FBA00"/>
         <Rectangle Canvas.Left="0" Canvas.Top="7.5" Width="6.5" Height="6.5" Fill="#00A4EF"/>
         <Rectangle Canvas.Left="7.5" Canvas.Top="7.5" Width="6.5" Height="6.5" Fill="#FFB900"/>
        </Canvas>
       </Border>
       <TextBlock Text="Войти через Microsoft" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentLight}" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Grid x:Name="AddAccountPanel" Visibility="{Binding Profile.IsAddAccountOpen, Converter={StaticResource BoolToVis}}" Margin="6,6,6,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="AddAccountBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" MaxLength="16" Background="#111116" Foreground="White" CaretBrush="White"
               Style="{StaticResource ErrorableTextBox}" Tag="{Binding Profile.HasAddError, Converter={StaticResource ErrorTag}}"
               Text="{Binding Profile.NewAccountName, UpdateSourceTrigger=PropertyChanged}">
       <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Profile.AddAccountCommand}"/></TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Content="Добавить" Margin="8,0,0,0" Height="38" Padding="14,0" Style="{StaticResource SecondaryButton}" Command="{Binding Profile.AddAccountCommand}"/>
     </Grid>
     <Border Height="1" Background="#12FFFFFF" Margin="4,8,4,6"/>
     <Button Style="{StaticResource MenuItemButton}" Command="{Binding OpenAccountCommand}">
      <StackPanel Orientation="Horizontal">
       <Viewbox Width="16" Height="16" Margin="8,0,12,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconUser}"/></Canvas></Viewbox>
       <TextBlock Text="Профиль" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Style="{StaticResource MenuItemButton}" Command="{Binding OpenSettingsCommand}">
      <StackPanel Orientation="Horizontal">
       <Viewbox Width="16" Height="16" Margin="8,0,12,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}"/></Canvas></Viewbox>
       <TextBlock Text="Настройки" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
    </StackPanel>
   </Border>
  </Grid>

  <!-- ===== Выпадающий список версий: растёт вверх из кнопки «Версия» (позиция и размер считаются в коде окна) ===== -->
  <Grid x:Name="VDropHost" Panel.ZIndex="20" Visibility="Collapsed">
   <Border Background="Transparent">
    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding CloseVersionDropdownCommand}"/></Border.InputBindings>
   </Border>
   <Border x:Name="VDropCard" Width="380" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="240,0,0,142" Padding="10" CornerRadius="20" Background="#F5141419" BorderBrush="#1FFFFFFF" BorderThickness="1" Opacity="0" RenderTransformOrigin="0,1">
    <Border.RenderTransform><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="8" BlurRadius="30" Opacity="0.5"/></Border.Effect>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="8,4,8,8">
      <TextBlock Text="ВЕРСИИ И ЗАГРУЗЧИКИ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
      <TextBlock Text="{Binding VersionDropdown.StatusText}" Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
      <!-- Выбранная версия не установлена: говорим об этом прямо -->
      <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="12" Background="#14FBBF24" BorderBrush="#40FBBF24" BorderThickness="1"
              Visibility="{Binding VersionDropdown.ShowMissingNotice, Converter={StaticResource BoolToVis}}">
       <StackPanel>
        <TextBlock Text="{Binding VersionDropdown.MissingNoticeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FBBF24" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Это не помеха: лаунчер сам скачает нужные файлы в свой кэш при первом запуске."
                   FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
       </StackPanel>
      </Border>
      <!-- Нет установленных версий -->
      <StackPanel Margin="8,14,8,4" HorizontalAlignment="Center" Visibility="{Binding VersionDropdown.ShowEmptyState, Converter={StaticResource BoolToVis}}">
       <ctl:LoaderTile Kind="Vanilla" Size="44" HorizontalAlignment="Center"/>
       <TextBlock Text="Установленных версий не найдено" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock Text="{Binding VersionDropdown.EmptyHint}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextMuted}"/>
      </StackPanel>
     </StackPanel>
     <!-- Строки (заголовки загрузчиков и версии) виртуализируются: длинный список не подвешивает окно -->
     <ItemsControl x:Name="VDropList" Grid.Row="1" ItemsSource="{Binding VersionDropdown.Rows}" Focusable="False"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
      <ItemsControl.Template>
       <ControlTemplate TargetType="ItemsControl">
        <ScrollViewer x:Name="VDropScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
         <ItemsPresenter/>
        </ScrollViewer>
       </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
     <StackPanel Grid.Row="2">
      <Border Height="1" Background="#12FFFFFF" Margin="4,8,4,6"/>
      <Button Style="{StaticResource MenuItemButton}" Command="{Binding VersionDropdown.ShowAllCommand}">
       <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="8,0,12,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconLayers}"/></Canvas></Viewbox>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="Все версии Minecraft" FontSize="14" FontWeight="SemiBold"/>
         <TextBlock Text="Каталог релизов · файлы скачаются при запуске" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
       </StackPanel>
      </Button>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>

  <!-- ===== Режим «Все версии»: шапка и подвал уехали, снизу выезжают карточки ===== -->
  <Grid x:Name="VersionsPanel" Margin="24" Visibility="Collapsed" Opacity="0" Panel.ZIndex="5">
   <Grid.RenderTransform><TranslateTransform Y="140"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="8,6,8,14" Background="Transparent" PreviewMouseLeftButtonDown="Header_DragWindow">
    <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}" VerticalAlignment="Center" Command="{Binding ExitVersionsCommand}">
     <StackPanel Orientation="Horizontal">
      <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronUp}"/></Canvas></Viewbox>
      <TextBlock Text="Назад" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Все версии" FontSize="28" FontWeight="Black"/>
     <TextBlock Text="{Binding Versions.Subtitle}" Margin="0,2,0,0" FontSize="13.6" Foreground="{StaticResource TextMuted}"/>
    </StackPanel>
   </DockPanel>
   <!-- Поиск версий: при открытии «Все версии» съезжает сверху (анимация в окне) -->
   <Border x:Name="VersionsSearchBar" Grid.Row="1" Margin="8,0,8,14" Opacity="0">
    <Border.RenderTransform><TranslateTransform Y="-34"/></Border.RenderTransform>
    <StackPanel>
     <Border Height="44" CornerRadius="14" Background="#08FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Viewbox Width="16" Height="16" Margin="14,0,10,0"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource TextMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconSearch}"/></Canvas></Viewbox>
       <TextBlock Grid.Column="1" Text="Найти версию: 1.20.4, Tricky Trials, 26…" Foreground="{StaticResource TextMuted}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"
                  Visibility="{Binding Versions.HasSearchText, Converter={StaticResource InvBoolToVis}}"/>
       <TextBox x:Name="VersionSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="14" VerticalContentAlignment="Center"
                Text="{Binding Versions.SearchText, UpdateSourceTrigger=PropertyChanged}">
        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Versions.SubmitSearchCommand}"/></TextBox.InputBindings>
       </TextBox>
       <Button Grid.Column="2" Content="×" Style="{StaticResource NavButton}" FontSize="20" Padding="12,0" Margin="0,0,4,0"
               Command="{Binding Versions.ClearSearchCommand}" Visibility="{Binding Versions.HasSearchText, Converter={StaticResource BoolToVis}}"/>
      </Grid>
     </Border>
     <!-- Недавно выбранные версии (видны, пока поиск пуст) -->
     <StackPanel Margin="2,12,0,0" Visibility="{Binding Versions.ShowRecent, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="НЕДАВНИЕ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
      <ItemsControl ItemsSource="{Binding Versions.Recent}" ItemTemplate="{StaticResource RecentChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <TextBlock Grid.Row="2" Text="Ничего не найдено" Margin="10,6,0,0" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" IsHitTestVisible="False"
              Visibility="{Binding Versions.HasNoResults, Converter={StaticResource BoolToVis}}"/>
   <ScrollViewer x:Name="VersionsScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ScrollChanged="VersionsScroll_ScrollChanged">
    <!-- Секции (годы / «Старые версии») с карточками — по шаблонам из Views/Templates/VersionTemplates.xaml -->
    <ItemsControl x:Name="VersionsWrap" ItemsSource="{Binding Versions.Sections}" Margin="3,0,3,24" Focusable="False"/>
   </ScrollViewer>
  </Grid>

  <!-- ===== Страница версии: открывается кликом по карточке, список версий в это время гаснет ===== -->
  <Grid x:Name="VersionPage" DataContext="{Binding Versions.Page}" Margin="24" Visibility="Collapsed" Opacity="0" Panel.ZIndex="6">
   <Grid.RenderTransform><TranslateTransform Y="40"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="8,6,8,14" Background="Transparent" PreviewMouseLeftButtonDown="Header_DragWindow">
    <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" VerticalAlignment="Center" Command="{Binding BackCommand}">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="←" FontSize="16" Margin="0,0,8,1" VerticalAlignment="Center"/>
      <TextBlock Text="Все версии" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Button DockPanel.Dock="Right" Content="×" HorizontalAlignment="Right" Style="{StaticResource NavButton}" FontSize="22" VerticalAlignment="Center" Command="{Binding BackCommand}"/>
   </DockPanel>

   <Grid Grid.Row="1" Margin="8,0,8,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>

    <!-- Текст и выбор конкретной версии -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,32,0">
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="VPLabel" Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentLight}">
       <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="VPTitle" Text="{Binding Title}" Margin="0,6,0,0" FontSize="46" FontWeight="Black" Foreground="#FFFFFF" TextWrapping="Wrap">
       <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="VPMeta" Text="{Binding Meta}" Margin="0,4,0,0" FontSize="13.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
       <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="VPSummary" Text="{Binding Summary}" Margin="0,16,0,0" FontSize="14.4" LineHeight="22" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="132">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="#D4D4D8"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsSummaryMuted}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
       <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
      </TextBlock>
      <StackPanel x:Name="VPVersionsBox" Margin="0,20,0,0">
       <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
       <TextBlock Text="{Binding VersionsLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
       <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False"/>
       </ScrollViewer>
      </StackPanel>
      <Button x:Name="VPSelectButton" Style="{StaticResource PlayButton}" Content="{Binding SelectButtonText}" Command="{Binding SelectCommand}" Margin="0,24,0,0" Width="280" Height="56" FontSize="17" HorizontalAlignment="Left">
       <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
      </Button>
     </StackPanel>
    </ScrollViewer>

    <!-- Картинка обновления и галерея -->
    <Grid Grid.Column="1">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border CornerRadius="22" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True" Background="#111114">
      <Border.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="10" BlurRadius="40" Opacity="0.5"/></Border.Effect>
      <Grid>
       <Border CornerRadius="21" Background="{Binding Placeholder, Converter={StaticResource ImageToBrush}}" RenderOptions.BitmapScalingMode="HighQuality"/>
       <ctl:PhotoBorder CornerRadius="21" Source="{Binding Image}" FadeInMilliseconds="450" SettleFrom="1.05" SettleMilliseconds="1200" CrossFade="True" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
     </Border>
     <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Visibility="{Binding HasThumbs, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden">
      <ItemsControl ItemsSource="{Binding Thumbs}" Focusable="False">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>

  <!-- ===== Создать сборку: полноэкранный раздел как «Новости»; шапка и подвал уезжают ===== -->
  <Grid x:Name="BuildsPanel" DataContext="{Binding Builds}" Margin="24" Visibility="Collapsed" Opacity="0" Panel.ZIndex="7">
   <Grid.RenderTransform><TranslateTransform Y="40"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="8,6,8,18" Background="Transparent" PreviewMouseLeftButtonDown="Header_DragWindow">
    <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}" VerticalAlignment="Center" Command="{Binding BackCommand}">
     <StackPanel Orientation="Horizontal">
      <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronUp}"/></Canvas></Viewbox>
      <TextBlock Text="Назад" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Создать сборку" FontSize="28" FontWeight="Black"/>
     <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="13.6" Foreground="{StaticResource TextMuted}"/>
    </StackPanel>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <ContentControl Content="{Binding}" Margin="8,0,8,24" Focusable="False" IsTabStop="False"/>
   </ScrollViewer>
  </Grid>

  <!-- ===== Новости: шапка и подвал уезжают; главная новость, карточки, категории, состояния загрузки / ошибки / пусто ===== -->
  <Grid x:Name="NewsPanel" DataContext="{Binding News}" Margin="24" Visibility="Collapsed" Opacity="0" Panel.ZIndex="7">
   <Grid.RenderTransform><TranslateTransform Y="40"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="8,6,8,14" Background="Transparent" PreviewMouseLeftButtonDown="Header_DragWindow">
    <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}" VerticalAlignment="Center" Command="{Binding BackCommand}">
     <StackPanel Orientation="Horizontal">
      <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronUp}"/></Canvas></Viewbox>
      <TextBlock Text="Назад" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Button x:Name="NewsRefreshButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Обновить новости"
            Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
     <StackPanel Orientation="Horizontal">
      <Viewbox x:Name="NewsRefreshIcon" Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
       <Viewbox.RenderTransform><RotateTransform Angle="0"/></Viewbox.RenderTransform>
       <Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}"/></Canvas>
      </Viewbox>
      <TextBlock Text="Обновить" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Новости" FontSize="28" FontWeight="Black"/>
     <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="13.6" Foreground="{StaticResource TextMuted}"/>
    </StackPanel>
   </DockPanel>

   <ScrollViewer x:Name="NewsTabsScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                 Visibility="{Binding IsDetailOpen, Converter={StaticResource InvBoolToVis}}">
    <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource NewsTabTemplate}" Margin="8,0,8,14" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </ScrollViewer>

   <Grid x:Name="NewsContentGrid" Grid.Row="2" Visibility="{Binding IsDetailOpen, Converter={StaticResource InvBoolToVis}}">
    <ScrollViewer x:Name="NewsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter=List}">
     <StackPanel Margin="8,0,8,24">
      <!-- Нет связи / часть источников не ответила -->
      <Border Margin="0,0,0,14" Padding="14,9" CornerRadius="12" Background="#14FBBF24" BorderBrush="#40FBBF24" BorderThickness="1"
              Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
       <TextBlock Text="{Binding Notice}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FBBF24" TextWrapping="Wrap"/>
      </Border>
      <ContentControl Content="{Binding Featured}" ContentTemplate="{StaticResource NewsFeaturedTemplate}" Focusable="False"/>
      <StackPanel Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
       <TextBlock Text="ЕЩЁ НОВОСТИ" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,4,0,10"/>
       <ItemsControl ItemsSource="{Binding More}" ItemTemplate="{StaticResource NewsSmallTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False"/>
      </StackPanel>
      <TextBlock Text="{Binding FooterNote}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="4,8,0,0"
                 Visibility="{Binding HasFooterNote, Converter={StaticResource BoolToVis}}"/>
     </StackPanel>
    </ScrollViewer>

    <StackPanel x:Name="NewsLoadingBox" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter=Loading}">
     <Border Width="220" Height="4" CornerRadius="2" Background="#16161A" ClipToBounds="True">
      <Border x:Name="NewsLoadingBar" Width="80" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentGradientPurple}">
       <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      </Border>
     </Border>
     <TextBlock Text="Загружаем новости…" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMuted}"/>
    </StackPanel>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter=State}">
     <Border Width="56" Height="56" CornerRadius="18" HorizontalAlignment="Center" Background="#1AA66BFF" BorderBrush="#40A66BFF" BorderThickness="1">
      <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource AccentPurple}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconFlame}"/></Canvas></Viewbox>
     </Border>
     <TextBlock Text="{Binding StateTitle}" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"/>
     <TextBlock Text="{Binding StateText}" Margin="0,6,0,0" MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Foreground="{StaticResource TextMuted}"/>
     <Button Content="{Binding StateButtonText}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="140"
             Visibility="{Binding HasStateButton, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
   </Grid>

   <!-- Полная новость: список и вкладки на это время скрыты -->
   <Grid x:Name="NewsDetail" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button Style="{StaticResource NavButton}" HorizontalAlignment="Left" Margin="0,0,0,12" Command="{Binding CloseDetailCommand}">
     <StackPanel Orientation="Horizontal">
      <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconArrowLeft}"/></Canvas></Viewbox>
      <TextBlock Text="Все новости" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Grid Grid.Row="1" Margin="8,0,8,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,32,0">
      <StackPanel VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <Border CornerRadius="10" Padding="10,4" Background="{Binding Detail.CategoryFill}" BorderBrush="{Binding Detail.CategoryBorder}" BorderThickness="1">
         <TextBlock Text="{Binding Detail.CategoryName}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Detail.CategoryBrush}"/>
        </Border>
        <TextBlock Text="{Binding Detail.DateText}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                   Visibility="{Binding Detail.HasDate, Converter={StaticResource BoolToVis}}"/>
       </StackPanel>
       <TextBlock Text="{Binding Detail.Title}" Margin="0,14,0,0" FontSize="34" FontWeight="Black" Foreground="#FFFFFF" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Detail.Body}" Margin="0,16,0,0" FontSize="14.4" LineHeight="22" Foreground="#D4D4D8" TextWrapping="Wrap"/>
       <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Command="{Binding OpenSiteCommand}"
               Visibility="{Binding Detail.CanOpenSite, Converter={StaticResource BoolToVis}}">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="Читать на сайте" VerticalAlignment="Center"/>
         <Viewbox Width="14" Height="14" Margin="8,0,0,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconExternal}"/></Canvas></Viewbox>
        </StackPanel>
       </Button>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Column="1" CornerRadius="22" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True" Background="#111114">
      <Border.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="10" BlurRadius="40" Opacity="0.5"/></Border.Effect>
      <Grid>
       <Border CornerRadius="21" Background="{Binding Detail.Placeholder, Converter={StaticResource ImageToBrush}}" RenderOptions.BitmapScalingMode="HighQuality"/>
       <ctl:PhotoBorder CornerRadius="21" Source="{Binding Detail.Image}" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
     </Border>
    </Grid>
   </Grid>
  </Grid>

  <!-- Уведомление «в разработке» и другие короткие сообщения -->
  <Border x:Name="ToastHost" Panel.ZIndex="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,150" Padding="18,12" CornerRadius="16" Background="#F2181820" BorderBrush="#55A66BFF" BorderThickness="1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
   <Border.Effect><DropShadowEffect Color="#000000" Direction="270" ShadowDepth="6" BlurRadius="24" Opacity="0.5"/></Border.Effect>
   <StackPanel Orientation="Horizontal">
    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentPurple}" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="ToastText" Text="{Binding Toast.Text}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
   </StackPanel>
  </Border>

  <!-- Модальные окна: на всю область окна, шапка и подвал в это время скрыты.
       Что внутри, решает тип Nav.Overlay: для каждого — свой DataTemplate (Views/Templates/OverlayTemplates.xaml). -->
  <Grid x:Name="OverlayPanel" Margin="24" Visibility="Collapsed" Panel.ZIndex="10" Opacity="0">
   <Border Background="#E60C0C0F" CornerRadius="24"/>
   <Border x:Name="OverlayCard" Width="{Binding Nav.Overlay.CardWidth, FallbackValue=680, TargetNullValue=680}" MaxHeight="{Binding Nav.Overlay.CardMaxHeight, FallbackValue=520, TargetNullValue=520}" Padding="28" Background="#141419" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Border.RenderTransform>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel>
      <TextBlock Text="{Binding Nav.Overlay.Title}" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" ToolTip="Закрыть" Command="{Binding CloseOverlayCommand}"/>
     </DockPanel>
     <ScrollViewer Grid.Row="1" Margin="0,25,0,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ContentControl Content="{Binding Nav.Overlay}" Focusable="False" IsTabStop="False"/>
     </ScrollViewer>
     <TextBlock Grid.Row="2" Text="SUBREEL LAUNCHER · CONCEPT PORT" FontSize="9" Foreground="{StaticResource TextMuted}"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
 </Border>
</Window>
