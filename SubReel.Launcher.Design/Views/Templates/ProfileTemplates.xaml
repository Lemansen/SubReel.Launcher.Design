<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:SubReel.Launcher.Design.ViewModels"
 xmlns:ctl="clr-namespace:SubReel.Launcher.Design.Views.Controls">
 <!-- Строка аккаунта в меню профиля -->
 <DataTemplate DataType="{x:Type vm:AccountItemViewModel}">
  <Grid>
   <Button Style="{StaticResource MenuItemButton}" Command="{Binding SwitchCommand}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ctl:AvatarControl AccountName="{Binding Name}" Look="{Binding Look}" Size="34" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Margin="12,0,28,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding Look.NickBrush}"/>
      <TextBlock Text="{Binding Kind}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
     </StackPanel>
     <Viewbox Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
      <Canvas Width="24" Height="24"><Path Stroke="{StaticResource AccentLight}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconCheck}"/></Canvas>
     </Viewbox>
    </Grid>
   </Button>
   <Button Style="{StaticResource WindowCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Удалить аккаунт"
           Command="{Binding RemoveCommand}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}">
    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconX}"/></Canvas></Viewbox>
   </Button>
  </Grid>
 </DataTemplate>
</ResourceDictionary>
