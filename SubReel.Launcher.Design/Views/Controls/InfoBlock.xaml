<UserControl x:Class="SubReel.Launcher.Design.Views.Controls.InfoBlock"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Блок «заголовок + пояснение» для модальных окон -->
 <StackPanel Margin="0,0,0,18">
  <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Detail, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
 </StackPanel>
</UserControl>
