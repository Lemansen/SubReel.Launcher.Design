<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Версия лаунчера: её читает проверка обновлений (AssemblyInformationalVersion). Поднимай перед выпуском и в манифесте обновлений. -->
    <Version>0.1.0</Version>
    <AssemblyInformationalVersion>0.1.0</AssemblyInformationalVersion>
  </PropertyGroup>
  <!-- Apply the requested executable name only to the WPF launcher project.
       A command-line AssemblyName global property would also rename every
       referenced project and make NuGet restore fail with an ambiguous name. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Subreel.Launcher.Design' and '$(LauncherAssemblyName)' != ''">
    <AssemblyName>$(LauncherAssemblyName)</AssemblyName>
    <AssemblyTitle>$(LauncherAssemblyName)</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Logos\*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubReel.Launcher.Application\SubReel.Launcher.Application.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Authentication\SubReel.Launcher.Authentication.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Domain\SubReel.Launcher.Domain.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Infrastructure\SubReel.Launcher.Infrastructure.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Minecraft\SubReel.Launcher.Minecraft.csproj" />
    <ProjectReference Include="..\SubReel.Launcher.Mods\SubReel.Launcher.Mods.csproj" />
  </ItemGroup>

</Project>
