  <SolidColorBrush x:Key="AccentPurple" Color="#A66BFF"/>
  <LinearGradientBrush x:Key="AccentGradientPurple" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#4C85FF" Offset="1"/>
  </LinearGradientBrush>

  <!-- Path иконки: цвет обводки берётся у родительской кнопки (как currentColor в вебе) -->
  <Style x:Key="IconPath" TargetType="Path">
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
   <Setter Property="StrokeThickness" Value="2"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/>
   <Setter Property="StrokeEndLineCap" Value="Round"/>
   <Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>

  <!-- .nav-links button -->
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,8"/>
   <Setter Property="FontSize" Value="14.4"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
     <Setter Property="Background" Value="#0AFFFFFF"/>
     <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
    </Trigger>
    <!-- Активная вкладка: Tag="active" (задаётся привязкой к NavigationService; идёт после hover, поэтому перекрывает его) -->
    <Trigger Property="Tag" Value="active">
     <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
     <Setter Property="Background" Value="#0D4C85FF"/>
     <Setter Property="BorderBrush" Value="#404C85FF"/>
    </Trigger>
   </Style.Triggers>
  </Style>

  <!-- Компактная кнопка закрытия окна (32x32, крестик 14 px). Раньше здесь стояла NavButton с «×» в 22 pt — отсюда был огромный прямоугольник -->
  <Style x:Key="CloseButton" TargetType="Button">
   <Setter Property="Width" Value="32"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
       <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconX}"/></Canvas></Viewbox>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- .window-btn (28x28) -->
  <Style x:Key="WindowButton" TargetType="Button">
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" CornerRadius="8">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#0DFFFFFF"/>
     <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#EF4444"/>
     <Setter Property="Foreground" Value="#FFFFFF"/>
    </Trigger>
   </Style.Triggers>
  </Style>

  <!-- Кнопка профиля: тёмная пилюля в стиле лаунчера (аватар, ник, стрелка).
       Рамка (BorderBrush / BorderThickness / Effect) и цвет ника задаются из кода по ProfileCosmetics (см. Cosmetics.cs):
       на наведении меняется только фон, чтобы не перебивать кастомную рамку. -->
  <Style x:Key="ProfilePill" TargetType="Button">
   <Setter Property="Background" Value="#141419"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="5,5,12,5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#1C1C23"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Строка меню профиля -->
  <Style x:Key="MenuItemButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- .news-chip -->
  <Style x:Key="NewsChip" TargetType="Button">
   <Setter Property="Background" Value="#D9141419"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="22,14"/>
   <Setter Property="FontSize" Value="13.6"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
       <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#141419"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="#4D4C85FF"/>
        <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- .secondary-btn (нижняя панель): высота 48, радиус 14 -->
  <Style x:Key="FooterButton" TargetType="Button">
   <Setter Property="Background" Value="#08FFFFFF"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Height" Value="48"/>
   <Setter Property="Padding" Value="20,0"/>
   <Setter Property="FontSize" Value="14.4"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- .custom-btn-1: акцентная кнопка «Создать сборку» -->
  <Style x:Key="FooterButtonAccent" TargetType="Button" BasedOn="{StaticResource FooterButton}">
   <Setter Property="BorderBrush" Value="#334C85FF"/>
   <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#144C85FF"/></Trigger>
   </Style.Triggers>
  </Style>
  <!-- .custom-btn-2: приглушённая кнопка «Версия» -->
  <Style x:Key="FooterButtonMuted" TargetType="Button" BasedOn="{StaticResource FooterButton}">
   <Setter Property="Opacity" Value="0.7"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="#14FFFFFF"/></Trigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
   <Setter Property="Background" Value="#08FFFFFF"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="BorderBrush" Value="#18FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#664C85FF"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Карточка инструмента в SubReel Studio Hub: наведение подсвечивает рамку фиолетовым -->
  <!-- Карточка-«bento»: тёмная плитка с тонкой рамкой; при наведении рамка синеет. Выключенная (ещё не готовая) — тусклая и без реакции -->
  <Style x:Key="BentoCard" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="Background" Value="#0B0B10"/>
   <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="24"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}" ClipToBounds="True">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#101018"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="#804C85FF"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Opacity" Value="0.6"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Карточка источника с собственным цветом: фон-градиент задаёт сама карточка (не меняется при наведении), цвет рамки при наведении берётся из Tag.
       Выключенная карточка («Скоро») остаётся яркой, но без реакции на мышь -->
  <Style x:Key="BrandCard" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="Background" Value="#0B0B10"/>
   <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="24"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}" ClipToBounds="True">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
       </Border>
       <Border x:Name="Hover" CornerRadius="22" BorderThickness="2" BorderBrush="{TemplateBinding Tag}" Opacity="0" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="0.85"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter TargetName="Hover" Property="Opacity" Value="0"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="HubCard" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="Background" Value="#B8141419"/>
   <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="20"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#D91B1B24"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="#66A66BFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Карточка новости: фото и затемнение лежат внутри Content (со своими скруглениями), поэтому Padding = 0 -->
  <Style x:Key="NewsCard" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="Background" Value="#111114"/>
   <Setter Property="BorderBrush" Value="#14FFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#804C85FF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Карточка версии: фон-заглушка задаётся в коде (Background); фото и затемнение под текст лежат внутри Content
       (см. CreateCard), поэтому фото может плавно проявляться поверх заглушки. Tag="selected" — рамка акцентного цвета. -->
  <Style x:Key="VersionCard" TargetType="Button">
   <Setter Property="Width" Value="190"/>
   <Setter Property="Height" Value="140"/>
   <Setter Property="Margin" Value="5"/>
   <Setter Property="BorderBrush" Value="#14FFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" RenderTransformOrigin="0.5,0.5">
       <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
       <ContentPresenter Margin="14"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="#A678C8FF"/>
        <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value></Setter>
       </Trigger>
       <Trigger Property="Tag" Value="selected">
        <Setter TargetName="Bd" Property="BorderBrush" Value="#4C85FF"/>
        <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- .play-btn: Tag="loading" → серая кнопка, Tag="running" → свечение (игра запущена; как .loading-state / .ready-state) -->
  <Style x:Key="PlayButton" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
   <Setter Property="Foreground" Value="#000000"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="20"/>
   <Setter Property="FontWeight" Value="Black"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
       <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter>
        <Setter TargetName="Bd" Property="Effect"><Setter.Value><DropShadowEffect Color="#4C85FF" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.35"/></Setter.Value></Setter>
       </Trigger>
       <Trigger Property="Tag" Value="running">
        <Setter TargetName="Bd" Property="Effect"><Setter.Value><DropShadowEffect Color="#78C8FF" Direction="270" ShadowDepth="8" BlurRadius="30" Opacity="0.4"/></Setter.Value></Setter>
       </Trigger>
       <Trigger Property="Tag" Value="loading">
        <Setter TargetName="Bd" Property="Background" Value="#1C1C21"/>
        <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
        <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
        <Setter Property="Foreground" Value="#4B4B54"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- .bar / .fill: трек #16161A, градиентная заливка, высота 8, полностью скруглённые края -->
  <Style x:Key="LaunchProgressBar" TargetType="ProgressBar">
   <Setter Property="Height" Value="8"/>
   <Setter Property="Minimum" Value="0"/>
   <Setter Property="Maximum" Value="100"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ProgressBar">
      <Grid>
       <Border x:Name="PART_Track" Background="#16161A" CornerRadius="4"/>
       <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource AccentGradient}" CornerRadius="4"/>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
</ResourceDictionary>
