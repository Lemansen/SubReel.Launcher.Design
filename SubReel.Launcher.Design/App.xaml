<Application x:Class="SubReel.Launcher.Design.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- StartupUri нет: окно и ViewModel-и создаёт App.OnStartup (корень композиции).
      Порядок важен: словарь может ссылаться (StaticResource) только на то, что подключено выше него. -->
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Resources/Theme.xaml"/>
    <ResourceDictionary Source="Resources/ControlStyles.xaml"/>
    <ResourceDictionary Source="Resources/Converters.xaml"/>
    <ResourceDictionary Source="Views/Templates/ProfileTemplates.xaml"/>
    <ResourceDictionary Source="Views/Templates/OverlayTemplates.xaml"/>
    <ResourceDictionary Source="Views/Templates/VersionTemplates.xaml"/>
    <ResourceDictionary Source="Views/Templates/NewsTemplates.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Application.Resources>
</Application>
